{
  "name": "threaded-nexus",
  "version": "0.1.0",
  "private": true,
  "description": "Always-on personal CRM + outreach copilot + workflow automation",
  "author": "Henrique Oliveira",
  "homepage": "https://github.com/henryxoliveira/threaded-nexus-v1",
  "repository": {
    "type": "git",
    "url": "https://github.com/henryxoliveira/threaded-nexus-v1.git"
  },
  "bugs": {
    "url": "https://github.com/henryxoliveira/threaded-nexus-v1/issues"
  },
  "scripts": {
    "dev": "pnpm run --parallel dev --filter \"./apps/*\"",
    "build": "pnpm -r run build",
    "lint": "eslint apps packages",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @threaded-nexus/db exec prisma migrate deploy",
    "db:studio": "pnpm --filter @threaded-nexus/db exec prisma studio",
    "db:generate": "pnpm --filter @threaded-nexus/db exec prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.14.2",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
