# Copy to .env and fill in. Never commit .env.

# Database (matches docker-compose default)
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/threaded_nexus

# Redis (matches docker-compose default)
REDIS_URL=redis://localhost:6379

# API server port
PORT=3001

# Web app: base URL of the API (for fetch)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: OpenAI (for real LLM provider; not required for local dev)
# OPENAI_API_KEY=sk-...
